
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900">

    <div class="w-full min-h-screen flex items-center justify-center px-4">

        <div class="w-full max-w-md bg-zinc-800 p-8 rounded-2xl shadow-2xl">

            <h1 class="text-3xl font-bold text-white text-center mb-2 ">
                Upload Profile Picture
            </h1>
        
            

            <form autocomplete="off" action="/upload" method="POST" class="space-y-5" enctype="multipart/form-data">

        <input type="file" name="image">
     
               <input class="px-5 py-2 rounded-md bg-blue-500" type="submit" value="Upload File">
            </form>

        </div>

    </div>

</body>
</html>