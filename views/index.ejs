
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create User</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900">

    <div class="w-full min-h-screen flex items-center justify-center px-4">

        <div class="w-full max-w-md bg-zinc-800 p-8 rounded-2xl shadow-2xl">

            <h1 class="text-3xl font-bold text-white text-center mb-2">
                Create Account
            </h1>
        
            <p class="text-zinc-400 text-center mb-8">
                Fill all details carefully
            </p>

            <form action="/register" method="POST" class="space-y-5">

                <input 
                    type="text" 
                    name="name" 
                    placeholder="Enter Name"
                    class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder:text-zinc-400 outline-none border border-zinc-600 focus:border-cyan-500"
                    required
                >

                <input 
                    type="text" 
                    name="username" 
                    placeholder="Enter Username"
                    class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder:text-zinc-400 outline-none border border-zinc-600 focus:border-cyan-500"
                    required
                >

                <input 
                    type="number" 
                    name="age" 
                    placeholder="Enter Age"
                    class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder:text-zinc-400 outline-none border border-zinc-600 focus:border-cyan-500"
                    required
                >

                <input 
                    type="email" 
                    name="email" 
                    placeholder="Enter Email"
                    class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder:text-zinc-400 outline-none border border-zinc-600 focus:border-cyan-500"
                    required
                >

                <input 
                    type="password" 
                    name="password" 
                    placeholder="Enter Password"
                    class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder:text-zinc-400 outline-none border border-zinc-600 focus:border-cyan-500"
                    required
                >

                <button 
                    type="submit"
                    class="w-full bg-cyan-500 hover:bg-cyan-600 transition-all duration-200 p-3 rounded-lg text-lg font-semibold text-white cursor-pointer"
                >
                    Create User
                </button>

                <p class="text-zinc-400 text-center mb-8">
                  Already have an account?  </p>

                <div class="flex justify-center">
             <a href="/login" class="bg-zinc-700 hover:bg-zinc-600 active:scale-95 text-white font-medium px-6 py-2.5 rounded-lg transition-all duration-200">
                                    Login
                                    </a>
                               </div>

            </form>

        </div>

    </div>

</body>
</html>